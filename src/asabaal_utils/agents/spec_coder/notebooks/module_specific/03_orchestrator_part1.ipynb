    "# Cell 5: _clean_test_file_content Method - AI Content Processing\n",
    "def add_clean_test_content_method(orchestrator_class):\n",
    "    def _clean_test_file_content(self, content: str) -> str:\n",
    "        \"\"\"\n",
    "        Clean AI-generated test file content to remove instructional text and fix formatting issues.\n",
    "        \n",
    "        This private method processes raw AI-generated test code to remove common artifacts\n",
    "        that cause syntax errors, particularly indentation errors.\n",
    "        \"\"\"\n",
    "        lines = content.split('\\n')\n",
    "        cleaned_lines = []\n",
    "        in_code_block = False\n",
    "        \n",
    "        for line in lines:\n",
    "            stripped = line.strip()\n",
    "            \n",
    "            # Skip empty lines and common AI instructional text\n",
    "            if not stripped:\n",
    "                continue\n",
    "            \n",
    "            # Skip markdown code block markers\n",
    "            if stripped.startswith('```'):\n",
    "                in_code_block = not in_code_block\n",
    "                continue\n",
    "            \n",
    "            # Skip instructional comments\n",
    "            if any(stripped.startswith(prefix) for prefix in [\n",
    "                'Note:', 'TODO:', 'Replace', 'Example:', 'Here', 'This test',\n",
    "                '# Note:', '# TODO:', '# Replace', '# Example'\n",
    "            ]):\n",
    "                continue\n",
    "            \n",
    "            # Skip template placeholders\n",
    "            if 'your_module' in stripped or 'your_function' in stripped:\n",
    "                continue\n",
    "            \n",
    "            # Only add if we're in a code block or it looks like Python code\n",
    "            if in_code_block or stripped.startswith(('def ', 'class ', 'import ', 'from ', 'assert ', '    ')):\n",
    "                cleaned_lines.append(line)\n",
    "        \n",
    "        return '\\n'.join(cleaned_lines)\n",
    "    \n",
    "    orchestrator_class._clean_test_file_content = _clean_test_file_content\n",
    "\n",
    "# Add the method to our orchestrator\n",
    "add_clean_test_content_method(IntegrationOrchestrator)\n",
    "\n",
    "# Test the method\n",
    "orchestrator = IntegrationOrchestrator()\n",
    "\n",
    "test_content = '''\n",
    "```python\n",
    "# Note: This is a test file\n",
    "# TODO: Replace with your_module\n",
    "def test_example():\n",
    "    # This test checks the functionality\n",
    "    assert True\n",
    "```\n",
    "Example usage:\n",
    "Replace this with actual tests\n",
    "'''\n",
    "\n",
    "cleaned = orchestrator._clean_test_file_content(test_content)\n",
    "\n",
    "print(\"✅ _clean_test_file_content method added and tested\")\n",
    "print(\"\\nOriginal content:\")\n",
    "print(repr(test_content))\n",
    "print(\"\\nCleaned content:\")\n",
    "print(repr(cleaned))\n",
    "print(\"\\nCleaned content (formatted):\")\n",
    "print(cleaned)\n",
    "\n",
    "print(\"\\nMethod breakdown:\")\n",
    "print(\"  • Split content into lines for processing\")\n",
    "print(\"  • Track code block state with in_code_block flag\")\n",
    "print(\"  • Skip markdown markers (```python, ```)\" )\n",
    "print(\"  • Skip instructional comments and template placeholders\")\n",
    "print(\"  • Keep only actual Python code lines\")\n",
    "print(\"  • Return cleaned, executable Python code\")"
   ]
