    "# Cell 2: IntegrationOrchestrator Class - Constructor\n",
    "class IntegrationOrchestrator:\n",
    "    \"\"\"\n",
    "    Main integration orchestrator for the complete software development pipeline.\n",
    "    \n",
    "    This class manages the end-to-end process from OpenSpec specifications through\n",
    "    code generation, testing, analysis, and optional healing. It coordinates multiple\n",
    "    pipeline stages to transform specifications into working, tested code.\n",
    "    \n",
    "    The pipeline consists of four main stages:\n",
    "    1. Spec to Scaffold: Generate basic code structure from specification\n",
    "    2. Scaffold to Requirements: Extract and analyze requirements\n",
    "    3. Requirements to Alignment: Align tests with requirements\n",
    "    4. Alignment to Code: Generate final code with proper test coverage\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self, base_dir: Optional[Path] = None):\n",
    "        \"\"\"\n",
    "        Initialize the IntegrationOrchestrator with the specified base directory.\n",
    "        \n",
    "        Args:\n",
    "            base_dir: Base directory for pipeline operations\n",
    "        \"\"\"\n",
    "        # Use current working directory as base if not provided\n",
    "        if base_dir is None:\n",
    "            self.base_dir = Path.cwd()\n",
    "        else:\n",
    "            self.base_dir = base_dir\n",
    "        \n",
    "        # Track the spec file path used for this pipeline run\n",
    "        self.spec_file_path = None\n",
    "            \n",
    "        self.scripts_dir = self.base_dir / \"scripts\"\n",
    "        self.healer_dir = self.base_dir / \"healer\"\n",
    "        self.prompts_dir = self.base_dir / \"prompts\"\n",
    "        self.generated_dir = self.base_dir / \"generated_functions\"\n",
    "        \n",
    "        print(f\"🧩 Integration Orchestrator\")\n",
    "        print(f\"📁 Base directory: {self.base_dir}\")\n",
    "\n",
    "# Test the constructor\n",
    "orchestrator = IntegrationOrchestrator()\n",
    "print(f\"✅ IntegrationOrchestrator created: {type(orchestrator)}\")\n",
    "print(f\"Base directory: {orchestrator.base_dir}\")\n",
    "print(f\"Scripts directory: {orchestrator.scripts_dir}\")\n",
    "print(f\"Healer directory: {orchestrator.healer_dir}\")\n",
    "print(f\"Prompts directory: {orchestrator.prompts_dir}\")\n",
    "print(f\"Generated directory: {orchestrator.generated_dir}\")\n",
    "\n",
    "print(\"\\nConstructor breakdown:\")\n",
    "print(\"  • base_dir handling - Uses current directory if None provided\")\n",
    "print(\"  • spec_file_path tracking - Stores current specification file path\")\n",
    "print(\"  • Directory setup - Configures all pipeline component directories\")\n",
    "print(\"  • Path construction - Uses pathlib for cross-platform compatibility\")"
   ]
