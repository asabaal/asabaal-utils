    "# Cell 7: run_full_pipeline Method - Complete Orchestration\n",
    "def add_full_pipeline_method(orchestrator_class):\n",
    "    def run_full_pipeline(self, spec_file: Path, output_dir: Optional[Path] = None) -> bool:\n",
    "        \"\"\"\n",
    "        Run the complete 4-stage pipeline from specification to final code.\n",
    "        \n",
    "        This is the main entry point that orchestrates all pipeline stages\n",
    "        in sequence, handling errors and managing intermediate files.\n",
    "        \"\"\"\n",
    "        if output_dir is None:\n",
    "            output_dir = self.generated_dir\n",
    "        \n",
    "        # Store spec file path for metadata\n",
    "        self.spec_file_path = spec_file\n",
    "        \n",
    "        print(f\"🚀 Starting full pipeline: {spec_file} → {output_dir}\")\n",
    "        start_time = time.time()\n",
    "        \n",
    "        # Create stage directories\n",
    "        stage1_dir = output_dir / \"stage1_scaffold\"\n",
    "        stage2_dir = output_dir / \"stage2_requirements\" \n",
    "        stage3_dir = output_dir / \"stage3_alignment\"\n",
    "        stage4_dir = output_dir / \"stage4_final_code\"\n",
    "        \n",
    "        try:\n",
    "            # Run all stages in sequence\n",
    "            stages = [\n",
    "                (\"Stage 1\", lambda: self.run_stage1_spec_to_scaffold(spec_file, stage1_dir)),\n",
    "                (\"Stage 2\", lambda: self.run_stage2_scaffold_to_requirements(stage1_dir, stage2_dir)),\n",
    "                (\"Stage 3\", lambda: self.run_stage3_requirements_to_alignment(stage2_dir, stage3_dir)),\n",
    "                (\"Stage 4\", lambda: self.run_stage4_alignment_to_code(stage3_dir, stage4_dir))\n",
    "            ]\n",
    "            \n",
    "            for stage_name, stage_func in stages:\n",
    "                print(f\"\\n📍 Running {stage_name}...\")\n",
    "                if not stage_func():\n",
    "                    print(f\"❌ Pipeline failed at {stage_name}\")\n",
    "                    return False\n",
    "            \n",
    "            # Save pipeline metadata\n",
    "            self._save_pipeline_metadata(output_dir, start_time)\n",
    "            \n",
    "            execution_time = time.time() - start_time\n",
    "            print(f\"\\n🎉 Pipeline completed successfully in {execution_time:.2f} seconds\")\n",
    "            print(f\"📁 Final output: {stage4_dir}\")\n",
    "            \n",
    "            return True\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"❌ Pipeline failed with error: {e}\")\n",
    "            return False\n",
    "    \n",
    "    def _save_pipeline_metadata(self, output_dir: Path, start_time: float):\n",
    "        \"\"\"Save pipeline execution metadata.\"\"\"\n",
    "        reports_dir = self.get_reports_dir(output_dir)\n",
    "        reports_dir.mkdir(parents=True, exist_ok=True)\n",
    "        \n",
    "        metadata = {\n",
    "            \"spec_file_path\": str(self.spec_file_path),\n",
    "            \"pipeline_start\": datetime.fromtimestamp(start_time).isoformat(),\n",
    "            \"pipeline_end\": datetime.now().isoformat(),\n",
    "            \"execution_time\": time.time() - start_time,\n",
